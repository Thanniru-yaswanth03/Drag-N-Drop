{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KanbanBoardSchema",
  "description": "JSON Schema specification for Kanban Studio multi-project state",
  "type": "object",
  "properties": {
    "boardId": {
      "type": "string",
      "description": "Unique identifier for the board"
    },
    "userId": {
      "type": "string",
      "description": "Owner user identifier"
    },
    "columns": {
      "type": "array",
      "description": "Ordered list of columns on the Kanban board",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique column identifier"
          },
          "title": {
            "type": "string",
            "description": "Display title of the column"
          },
          "cardIds": {
            "type": "array",
            "description": "Ordered list of card IDs belonging to this column",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["id", "title", "cardIds"],
        "additionalProperties": false
      }
    },
    "cards": {
      "type": "object",
      "description": "Dictionary of card objects keyed by card ID",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique card identifier"
          },
          "title": {
            "type": "string",
            "description": "Short title of the card"
          },
          "details": {
            "type": "string",
            "description": "Detailed description or notes for the card"
          },
          "description": {
            "type": "string",
            "description": "Detailed task description"
          },
          "priority": {
            "type": "string",
            "enum": ["low", "medium", "high"],
            "description": "Task priority level"
          },
          "dueDate": {
            "type": ["string", "null"],
            "description": "Task due date in ISO or YYYY-MM-DD format"
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "List of tag labels associated with the task"
          },
          "assignee": {
            "type": ["string", "null"],
            "description": "Assigned user identifier or display name"
          },
          "createdAt": {
            "type": ["string", "null"],
            "description": "ISO timestamp when the task was created"
          },
          "updatedAt": {
            "type": ["string", "null"],
            "description": "ISO timestamp when the task was last updated"
          }
        },
        "required": ["id", "title"],
        "additionalProperties": true
      }
    }
  },
  "required": ["columns", "cards"],
  "definitions": {
    "Project": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique project/board identifier" },
        "name": { "type": "string", "description": "Display name of the project" },
        "createdAt": { "type": ["string", "null"], "description": "Creation timestamp" },
        "updatedAt": { "type": ["string", "null"], "description": "Last update timestamp" }
      },
      "required": ["id", "name"]
    }
  },
  "additionalProperties": true
}

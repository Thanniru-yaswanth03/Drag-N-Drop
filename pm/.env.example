# Environment Configuration Template
ENVIRONMENT=production
SECRET_KEY=replace-with-a-secure-random-32-character-key
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000

# OpenRouter / Gemini API Key Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Security & Rate Limiting
RATE_LIMIT_LOGIN_MAX=15
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# Database Persistence & Auto-Seeding
DATABASE_PATH=pm.db
AUTO_SEED_USERS=yash,user
DEFAULT_USER_PASSWORD=password

